# ivulatechnologies.com: Apache settings for the cPanel public_html.
# HTTPS: turn on cPanel → Domains → "Force HTTPS Redirect" (managed by cPanel,
# nothing to maintain here).

Options -Indexes
ErrorDocument 404 /404.html

# Never serve dotfiles (except .well-known for SSL checks) or packaging leftovers.
<FilesMatch "(^\.(?!well-known)|~$|\.(bak|zip|md|sh|log|jsonl)$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^products/cannopy/?$ /products/canopy/ [R=301,L]
  RewriteRule ^products/leadfast/?$ /products/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Pages revalidate on every visit so an upload shows at once. Next.js build
  # files have a content hash in their names, so browsers can keep them a year.
  # Images, video and fonts keep a month.
  <FilesMatch "\.(html|txt|xml|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|gif|ico|mp4|webm|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

AddType video/webm .webm
AddType video/mp4 .mp4
AddType image/webp .webp
